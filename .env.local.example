# Shopify Partner App credentials
# Client ID and Secret from: partners.shopify.com → Apps → your app → Overview
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=your-client-id
SHOPIFY_CLIENT_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# App URL — must be whitelisted in Partner Dashboard → App setup → Redirect URLs
# Add: https://your-domain.com/api/auth/callback
APP_URL=http://localhost:3000

# Random 32-byte hex secret for encrypting the session cookie
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=generate-a-random-secret

# Omnisend API
# Found in Omnisend → Account → Integrations → API Keys
OMNISEND_API_KEY=your-omnisend-api-key

# Storefront origin allowed to call /api/public/* (the back-in-stock widget) cross-origin.
# Must match the storefront's public domain exactly, e.g. https://carladopazo.com
STOREFRONT_ORIGIN=https://your-store-domain.com

# Ollama cloud API key — powers the "Draft with AI" button in Customer Service.
# Get one at https://ollama.com/settings/keys
OLLAMA_API_KEY=your-ollama-api-key

# Pinecone API key — retrieval step in front of "Draft with AI" (semantic search over
# macros/policy docs uploaded to the "lela" Pinecone Assistant; gemma4 still writes the draft).
# Get one at https://app.pinecone.io → API Keys
PINECONE_API_KEY=your-pinecone-api-key

# Instagram App credentials — powers the Instagram DM tab in Customer Service.
# Uses Meta's "Instagram API with Instagram Login" product (no Facebook Page/Login involved).
# From developers.facebook.com → your app → the Instagram API product's own setup page
# ("Instagram App ID" / "Instagram App Secret" there — NOT Settings → Basic's App ID).
# Also requires a redirect URI registered on that same page:
# {APP_URL}/api/instagram/auth/callback
IG_APP_ID=your-instagram-app-id
IG_APP_SECRET=your-instagram-app-secret

# Odoo API — connection-status check only (no data sync yet)
# ODOO_URL is your instance's base URL, e.g. https://your-company.odoo.com (no trailing slash, no /jsonrpc)
# ODOO_DB is the database name — for Odoo Online this is usually your subdomain (the part before .odoo.com)
# ODOO_API_KEY is generated in Odoo: your user avatar → My Profile → Account Security → API Keys → New API Key
ODOO_URL=https://your-company.odoo.com
ODOO_DB=your-company
ODOO_USERNAME=you@example.com
ODOO_API_KEY=your-odoo-api-key
